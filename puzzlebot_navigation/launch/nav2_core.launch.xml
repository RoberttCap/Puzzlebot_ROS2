<launch>
    <let name="nav2_bringfup_launch_path" value="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py" />
    <arg name="map_path" default="$(find-pkg-share puzzlebot_navigation)/maps/map.yaml" />
    <arg name="nav2_params_file" default="$(find-pkg-share puzzlebot_navigation)/config/nav2_params.yaml" />
    <arg name="nav2_rviz_config_path" default="$(find-pkg-share puzzlebot_navigation)/rviz/nav2.rviz" />
    <arg name="use_sim_time" default="true" />

    <include file="$(var nav2_bringfup_launch_path)" >
        <arg name="map" value="$(var map_path)" />
        <arg name="params_file" value="$(var nav2_params_file)" />
        <arg name="use_sim_time" value="$(var use_sim_time)" />
    </include>
    <node pkg="rviz2" exec="rviz2" name="nav2_rviz" output="screen" args="-d $(var nav2_rviz_config_path)">
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>
    


</launch>
