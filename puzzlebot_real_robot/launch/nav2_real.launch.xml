<launch>
  <arg name="map" default="$(find-pkg-share puzzlebot_real_robot)/maps/map_maze_real.yaml"/>
  <arg name="params_file" default="$(find-pkg-share puzzlebot_real_robot)/config/nav2_params_real.yaml"/>
  <arg name="rviz" default="true"/>
  <arg name="use_micro_ros" default="false"/>
  <arg name="use_rplidar" default="false"/>
  <arg name="right_wheel_topic" default="wr"/>
  <arg name="left_wheel_topic" default="wl"/>

  <include file="$(find-pkg-share puzzlebot_real_robot)/launch/real_robot_core.launch.xml">
    <arg name="use_micro_ros" value="$(var use_micro_ros)"/>
    <arg name="use_rplidar" value="$(var use_rplidar)"/>
    <arg name="right_wheel_topic" value="$(var right_wheel_topic)"/>
    <arg name="left_wheel_topic" value="$(var left_wheel_topic)"/>
  </include>

  <include file="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py">
    <arg name="map" value="$(var map)"/>
    <arg name="use_sim_time" value="false"/>
    <arg name="params_file" value="$(var params_file)"/>
  </include>

  <node if="$(var rviz)" pkg="rviz2" exec="rviz2" name="rviz2" output="screen"/>
</launch>