<?xml version="1.0"?>
<launch>
  <!-- One-shot bringup for the physical Puzzlebot:
       hardware + dead-reckoning odometry + TF first, then Nav2/AMCL. -->

  <arg name="use_sim_time" default="false"/>
  <arg name="map" default="$(find-pkg-share puzzlebot_real_robot)/maps/map_maze_real.yaml"/>
  <arg name="autostart" default="true"/>
  <arg name="use_composition" default="False"/>
  <arg name="nav2_start_delay" default="4.0"/>

  <!-- Hardware driver switches -->
  <arg name="use_micro_ros" default="true"/>
  <arg name="use_rplidar" default="true"/>
  <arg name="rplidar_serial_port" default="/dev/ttyUSB1"/>
  <arg name="rplidar_serial_baudrate" default="115200"/>
  <arg name="scan_topic" default="scan"/>
  <arg name="lidar_frame" default="laser_frame"/>

  <!-- micro-ROS Agent configuration -->
  <arg name="micro_ros_transport" default="serial"/>
  <arg name="micro_ros_device" default="/dev/ttyUSB0"/>
  <arg name="micro_ros_baudrate" default="115200"/>

  <!-- Real encoder topics from the robot firmware / micro-ROS -->
  <arg name="right_wheel_topic" default="/VelocityEncR"/>
  <arg name="left_wheel_topic" default="/VelocityEncL"/>

  <!-- Physical robot parameters -->
  <arg name="wheel_radius" default="0.05"/>
  <arg name="wheel_base" default="0.19"/>
  <arg name="right_wheel_scale" default="1.0"/>
  <arg name="left_wheel_scale" default="1.0"/>
  <arg name="publish_odom_tf" default="true"/>

  <include if="$(var bringup_core)" file="$(find-pkg-share puzzlebot_real_robot)/launch/real_robot_core.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="use_micro_ros" value="$(var use_micro_ros)"/>
    <arg name="use_rplidar" value="$(var use_rplidar)"/>
    <arg name="rplidar_serial_port" value="$(var rplidar_serial_port)"/>
    <arg name="rplidar_serial_baudrate" value="$(var rplidar_serial_baudrate)"/>
    <arg name="scan_topic" value="$(var scan_topic)"/>
    <arg name="lidar_frame" value="$(var lidar_frame)"/>
    <arg name="micro_ros_transport" value="$(var micro_ros_transport)"/>
    <arg name="micro_ros_device" value="$(var micro_ros_device)"/>
    <arg name="micro_ros_baudrate" value="$(var micro_ros_baudrate)"/>
    <arg name="right_wheel_topic" value="$(var right_wheel_topic)"/>
    <arg name="left_wheel_topic" value="$(var left_wheel_topic)"/>
    <arg name="wheel_radius" value="$(var wheel_radius)"/>
    <arg name="wheel_base" value="$(var wheel_base)"/>
    <arg name="right_wheel_scale" value="$(var right_wheel_scale)"/>
    <arg name="left_wheel_scale" value="$(var left_wheel_scale)"/>
    <arg name="publish_odom_tf" value="$(var publish_odom_tf)"/>
    <arg name="use_localization" value="true"/>
    <arg name="use_joint_state_publisher" value="true"/>
  </include>

  <timer period="$(var nav2_start_delay)">
    <include file="$(find-pkg-share puzzlebot_real_robot)/launch/nav2_real.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="map" value="$(var map)"/>
      <arg name="autostart" value="$(var autostart)"/>
      <arg name="use_composition" value="$(var use_composition)"/>
    </include>
  </timer>
</launch>
