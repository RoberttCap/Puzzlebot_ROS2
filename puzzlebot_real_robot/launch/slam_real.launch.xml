<launch>
  <arg name="slam_params_file" default="$(find-pkg-share puzzlebot_real_robot)/config/slam_toolbox_real.yaml"/>
  <arg name="slam_rviz" default="true"/>
  <arg name="rviz_config_path" default="$(find-pkg-share puzzlebot_navigation)/rviz/slam.rviz"/>
  <arg name="teleop" default="true"/>
  <arg name="use_sim_time" default="false"/>

  <include file="$(find-pkg-share puzzlebot_navigation)/launch/slam_core.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="slam_params_file" value="$(var slam_params_file)"/>
    <arg name="rviz_config_path" value="$(var rviz_config_path)"/>
    <arg name="rviz" value="$(var slam_rviz)"/>
    <arg name="teleop" value="$(var teleop)"/>
  </include>
</launch>
